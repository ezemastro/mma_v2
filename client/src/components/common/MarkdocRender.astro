---
import Markdoc from "@markdoc/markdoc";
import type { Node } from "@markdoc/markdoc";

interface Props {
  // Keystatic's fields.markdoc() resolver returns its AST node typed
  // against its own (older, nested) @markdoc/markdoc install, which is a
  // structurally-identical but nominally different type from the
  // `@markdoc/markdoc` used here to render it. `unknown` sidesteps that
  // dependency-duplication mismatch without weakening anything we actually
  // check (we immediately hand it to Markdoc.transform, which is untyped
  // enough to accept it).
  content: () => Promise<{ node: unknown }>;
}

const { content } = Astro.props;

let htmlDescription = "";

if (content && typeof content === "function") {
  // 1. Resolvemos la promesa para obtener el AST (nodo)
  const { node } = await content();

  // 2. Transformamos el nodo al árbol de ejecución
  const renderableTree = Markdoc.transform(node as Node);

  // 3. Renderizamos a HTML puro
  htmlDescription = Markdoc.renderers.html(renderableTree);
}
---

<div class="tarjeta-descripcion prose prose-slate max-w-none">
  <Fragment set:html={htmlDescription} />
</div>
