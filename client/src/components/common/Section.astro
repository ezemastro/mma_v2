---
interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  link?: {
    href: string;
    label: string;
  };
  isFirst?: boolean;
  /** "muted" gives the section a soft tinted background instead of a top hairline. */
  tone?: "default" | "muted";
}

const { id, title, subtitle, link, isFirst, tone = "default" } = Astro.props;
const isMuted = tone === "muted";
---

<section
  id={id}
  class:list={[
    "px-4 scroll-mt-16",
    isFirst ? "pb-16 md:pb-20" : "py-16 md:py-20",
    isMuted && "bg-[#f7f7f7]",
  ]}
>
  <div
    class:list={[
      "mx-auto max-w-7xl",
      !isFirst && !isMuted && "border-t border-slate-200 pt-8",
    ]}
  >
    {
      title && (
        <div class="mb-12 text-center max-w-3xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight">{title}</h2>
          {subtitle && (
            <p class="mt-4 text-lg text-muted leading-relaxed">{subtitle}</p>
          )}
        </div>
      )
    }

    <slot />

    {
      link && link.href && link.label && (
        <div class="mt-8 text-center">
          <a
            href={link.href}
            class="inline-block rounded-[var(--radius)] bg-primary px-6 py-3 text-white transition-colors hover:bg-primary-dark"
          >
            {link.label}
          </a>
        </div>
      )
    }
  </div>
</section>
