---
interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  link?: {
    href: string;
    label: string;
  };
  isFirst?: boolean;
}

const { id, title, subtitle, link, isFirst } = Astro.props;
---

<section
  id={id}
  class:list={[{ "pt-0 md:pt-0": isFirst, "py-16 md:py-24": !isFirst }, "px-4", "scroll-mt-16"]}
>
  <div
    class:list={[
      {
        "border-t-0 pt-0": isFirst,
        "border-t border-slate-200 pt-12": !isFirst,
      },
      "max-w-7xl mx-auto",
    ]}
  >
    {
      title && (
        <div class="mb-12 text-center max-w-3xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight">{title}</h2>
          {subtitle && (
            <p class="mt-4 text-lg text-muted leading-relaxed">{subtitle}</p>
          )}
        </div>
      )
    }

    <slot />

    {
      link && link.href && link.label && (
        <div class="mt-8 text-center">
          <a
            href={link.href}
            class="inline-block rounded-[var(--radius)] bg-primary px-6 py-3 text-white transition-colors hover:bg-primary-dark"
          >
            {link.label}
          </a>
        </div>
      )
    }
  </div>
</section>
