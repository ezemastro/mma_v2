---
import Section from "../common/Section.astro";
import type { Entry } from "@keystatic/core/reader";
import keystaticConfig from "../../../keystatic.config";
import MarkdocRender from "../common/MarkdocRender.astro";
import Icon from "../common/Icon.astro";
import { Image } from "astro:assets";
import { resolveCmsImage } from "../../lib/cms-image";

type HomepageEntry = Entry<(typeof keystaticConfig)["singletons"]["homepage"]>;

type Props = Extract<
  HomepageEntry["sections"][number],
  { discriminant: "cards" }
>["value"] & {
  isFirst?: boolean;
  id?: string;
};

const { id, title, subtitle, content, image, variante, isFirst } = Astro.props;
const extraImage = resolveCmsImage(image);
---

<Section id={id} title={title} subtitle={subtitle} isFirst={isFirst}>
  {
    variante === "imagen-lista" ? (
      <div class="grid items-center gap-10 md:grid-cols-2">
        {extraImage && (
          <Image src={extraImage} alt={title} class="w-full rounded-[var(--radius)] object-contain" />
        )}
        <ul class="flex flex-col gap-8">
          {content.map((card) => (
            <li class="flex items-start gap-4">
              <Icon name={card.icon} class="size-10 shrink-0 text-primary" />
              <div>
                <h3 class="font-semibold text-dark">{card.title}</h3>
                <MarkdocRender content={card.description} />
              </div>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2">
        {content.map((card) => (
          <div class="flex flex-col items-center gap-3 p-6 text-center">
            <Icon name={card.icon} class="size-16 text-primary" />
            <h3 class="text-lg font-semibold text-dark">{card.title}</h3>
            <div class="h-1 w-12 rounded-full bg-primary" />
            <MarkdocRender content={card.description} />
            {card.link?.href && card.link?.label && (
              <a href={card.link.href} class="mt-1 text-sm font-semibold text-primary hover:text-primary-dark">
                {card.link.label}
              </a>
            )}
          </div>
        ))}
      </div>
    )
  }
</Section>
