---
import Section from "../common/Section.astro";
import type { Entry } from "@keystatic/core/reader";
import keystaticConfig from "../../../keystatic.config";
import MarkdocRender from "../common/MarkdocRender.astro";
import Icon from "../common/Icon.astro";
import { Image } from "astro:assets";
import { resolveCmsImage } from "../../lib/cms-image";

type HomepageEntry = Entry<(typeof keystaticConfig)["singletons"]["homepage"]>;

type Props = Extract<
  HomepageEntry["sections"][number],
  { discriminant: "cards" }
>["value"] & {
  isFirst?: boolean;
  id?: string;
};

const { id, title, subtitle, content, image, variante, tono, isFirst } = Astro.props;
const extraImage = resolveCmsImage(image);
---

<Section id={id} title={title} subtitle={subtitle} isFirst={isFirst} tone={tono}>
  {
    variante === "imagen-lista" ? (
      <div class="grid items-center gap-10 md:grid-cols-2">
        {extraImage && (
          <Image
            src={extraImage}
            alt={title}
            class="mx-auto w-full max-w-[300px] rounded-[var(--radius)] object-contain"
          />
        )}
        <ul class="flex flex-col gap-8">
          {content.map((card) => (
            <li class="flex items-start gap-4">
              <Icon name={card.icon} class="size-10 shrink-0 text-primary" />
              <div>
                <h3 class="font-semibold text-dark">{card.title}</h3>
                <MarkdocRender content={card.description} />
              </div>
            </li>
          ))}
        </ul>
      </div>
    ) : variante === "franja" ? (
      <ul class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4">
        {content.map((card) => (
          <li class="flex flex-col gap-2 border-t border-slate-200 pt-4">
            <Icon name={card.icon} class="size-7 text-primary" />
            <h3 class="font-semibold text-dark">{card.title}</h3>
            <MarkdocRender content={card.description} />
            {card.link?.href && card.link?.label && (
              <a href={card.link.href} class="mt-auto text-sm font-semibold text-primary hover:text-primary-dark">
                {card.link.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {content.map((card) => (
          <div class="flex items-start gap-4 text-left">
            <Icon name={card.icon} class="size-10 shrink-0 text-primary" />
            <div>
              <h3 class="font-semibold text-dark">{card.title}</h3>
              <MarkdocRender content={card.description} />
              {card.link?.href && card.link?.label && (
                <a
                  href={card.link.href}
                  class="mt-1 inline-block text-sm font-semibold text-primary hover:text-primary-dark"
                >
                  {card.link.label}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    )
  }
</Section>
