---
import Section from "../common/Section.astro";
import type { Entry } from "@keystatic/core/reader";
import keystaticConfig from "../../../keystatic.config";
import { Image } from "astro:assets";
import { resolveCmsImage } from "../../lib/cms-image";

type HomepageEntry = Entry<(typeof keystaticConfig)["singletons"]["homepage"]>;

type Props = Extract<
  HomepageEntry["sections"][number],
  { discriminant: "clients" }
>["value"] & {
  isFirst?: boolean;
  id?: string;
};


const { id, title, subtitle, content, isFirst } = Astro.props;
---

<Section id={id} title={title} subtitle={subtitle} isFirst={isFirst}>
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-8">
    {
      content.map((client) => {
        const logo = resolveCmsImage(client.logo);
        return (
          <div class="flex aspect-[3/2] items-center justify-center rounded-[var(--radius)] border border-slate-200 bg-white p-3 transition-colors hover:border-primary/40">
            {logo && (
              <Image src={logo} alt={client.name} class="max-h-[75%] max-w-[75%] w-auto object-contain" />
            )}
          </div>
        );
      })
    }
  </div>
</Section>
