---
import Section from "../common/Section.astro";
import type { Entry } from "@keystatic/core/reader";
import keystaticConfig from "../../../keystatic.config";
import { Image } from "astro:assets";
import { resolveCmsImage } from "../../lib/cms-image";

type HomepageEntry = Entry<(typeof keystaticConfig)["singletons"]["homepage"]>;

type Props = Extract<
  HomepageEntry["sections"][number],
  { discriminant: "clients" }
>["value"] & {
  isFirst?: boolean;
  id?: string;
};


const { id, title, subtitle, content, isFirst } = Astro.props;
---

<Section id={id} title={title} subtitle={subtitle} isFirst={isFirst}>
  <div class="grid grid-cols-3 gap-4 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">
    {
      content.map((client) => {
        const logo = resolveCmsImage(client.logo);
        return (
          <div class="flex aspect-square items-center justify-center rounded-[var(--radius)] border border-slate-100 bg-slate-50 p-3">
            {logo && (
              <Image
                src={logo}
                alt={client.name}
                class="max-h-10 w-auto object-contain grayscale transition-all duration-300 hover:grayscale-0"
              />
            )}
          </div>
        );
      })
    }
  </div>
</Section>
