---
import Section from "../common/Section.astro";
import type { Entry } from "@keystatic/core/reader";
import keystaticConfig from "../../../keystatic.config";

type HomepageEntry = Entry<(typeof keystaticConfig)["singletons"]["homepage"]>;

type Props = Extract<
  HomepageEntry["sections"][number],
  { discriminant: "stats" }
>["value"] & {
  isFirst?: boolean;
  id?: string;
};


const { id, calculated, projects, years, clients, isFirst } = Astro.props;

const items = [
  { value: `${(calculated ?? 0).toLocaleString("es-AR")} m²`, label: "Calculados" },
  { value: projects, label: "Proyectos realizados" },
  { value: `${years} años`, label: "De experiencia" },
  { value: clients, label: "Clientes satisfechos" },
];
---

<Section id={id} isFirst={isFirst}>
  <div class="grid grid-cols-2 gap-8 text-center md:grid-cols-4">
    {
      items.map((item) => (
        <div>
          <p class="text-3xl font-bold text-primary md:text-4xl">{item.value}</p>
          <p class="mt-2 text-sm text-muted md:text-base">{item.label}</p>
        </div>
      ))
    }
  </div>
</Section>
