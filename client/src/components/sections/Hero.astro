---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";

interface Props {
  headline: string;
  subtext: string;
  /** Slug of the obra whose portada illustrates the hero (header.heroObra). */
  heroObra: string | null;
}

const { headline, subtext, heroObra } = Astro.props;
const obra = heroObra ? await getEntry("obras", heroObra) : undefined;

// Built from the obra's own data so the caption stays correct whenever an
// editor swaps which obra is featured in the hero.
const caption = obra
  ? [obra.data.titulo.trim(), obra.data.ubicacion?.trim(), obra.data.descripcion.split(".")[0].trim()]
      .filter(Boolean)
      .join(". ") + "."
  : "";
---

<section class="px-4 pb-10 pt-8 md:px-12 md:pb-16 md:pt-12">
  <div class="mx-auto grid max-w-7xl items-center gap-8 lg:grid-cols-12 lg:gap-10">
    <div class="flex flex-col items-start gap-5 lg:col-span-5">
      <h1 class="text-4xl font-bold leading-[1.1] tracking-tight text-dark">
        {headline}
      </h1>
      <p class="max-w-lg text-lg text-muted">{subtext}</p>
      <div class="flex flex-wrap gap-3">
        <a
          href="/obras"
          class="rounded-[var(--radius)] bg-primary px-6 py-3 font-semibold text-white transition-colors hover:bg-primary-dark"
        >
          Ver obras
        </a>
        <a
          href="/contacto"
          class="rounded-[var(--radius)] border border-slate-300 px-6 py-3 font-semibold text-dark transition-colors hover:border-primary hover:text-primary"
        >
          Contacto
        </a>
      </div>
    </div>

    {
      obra && (
        <figure class="min-w-0 lg:col-span-7">
          <a
            href={`/obras/${obra.id}/`}
            class="block aspect-[4/3] overflow-hidden rounded-[var(--radius)] bg-slate-100"
          >
            <Image
              src={obra.data.portada}
              alt={obra.data.titulo}
              width={1120}
              widths={[560, 840, 1120, 1400]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </a>
          <figcaption class="mt-3 text-sm text-muted">
            <a href={`/obras/${obra.id}/`} class="hover:text-primary">
              {caption}
            </a>
          </figcaption>
        </figure>
      )
    }
  </div>
</section>
