---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import ObraCard from "../obras/ObraCard.astro";

interface Props {
  /** The obra shown in the hero: excluded here so its photo doesn't repeat. */
  excludeSlug?: string | null;
}

const { excludeSlug } = Astro.props;

// Replaces v1's auto-rotating TripleCarousel: a manual horizontal
// scroll-snap row (no autoplay) of the obras marked `destacada` in
// Keystatic, ordered by their `orden` field. The first one renders larger,
// a small asymmetric touch instead of N identical tiles.
const featured = (await getCollection("obras", (obra) => obra.data.destacada && obra.id !== excludeSlug)).sort(
  (a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0),
);
---

{
  featured.length > 0 && (
    <section class="px-4 py-16 md:px-12 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 flex items-end justify-between gap-4">
          <h2 class="text-3xl font-bold tracking-tight text-dark md:text-4xl">Obras destacadas</h2>
          <a href="/obras" class="hidden shrink-0 font-semibold text-primary hover:text-primary-dark sm:block">
            Ver todas las obras
          </a>
        </div>

        <div class="relative" data-featured-wrap>
          <div
            class="flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
            data-featured-row
          >
            {featured.map((obra, index) => (
              <div
                class:list={["shrink-0 snap-start", index === 0 ? "w-[300px] sm:w-[420px]" : "w-[260px] sm:w-[300px]"]}
              >
                <ObraCard obra={obra} eager={index < 2} priority={index === 0} />
              </div>
            ))}
          </div>

          <div
            class="pointer-events-none absolute inset-y-0 left-0 hidden w-10 bg-gradient-to-r from-white to-transparent sm:block"
            data-featured-fade-left
            hidden
          />
          <div
            class="pointer-events-none absolute inset-y-0 right-0 hidden w-10 bg-gradient-to-l from-white to-transparent sm:block"
            data-featured-fade-right
            hidden
          />

          <button
            type="button"
            aria-label="Obra anterior"
            data-featured-prev
            hidden
            class="absolute left-1 top-1/2 hidden -translate-y-1/2 items-center justify-center rounded-full border border-slate-200 bg-white p-2 text-dark shadow-sm transition-colors hover:border-primary hover:text-primary disabled:pointer-events-none disabled:opacity-0 sm:flex"
          >
            <Icon name="material-symbols:chevron-left-rounded" class="size-6" />
          </button>
          <button
            type="button"
            aria-label="Obra siguiente"
            data-featured-next
            hidden
            class="absolute right-1 top-1/2 hidden -translate-y-1/2 items-center justify-center rounded-full border border-slate-200 bg-white p-2 text-dark shadow-sm transition-colors hover:border-primary hover:text-primary disabled:pointer-events-none disabled:opacity-0 sm:flex"
          >
            <Icon name="material-symbols:chevron-right-rounded" class="size-6" />
          </button>
        </div>

        <a href="/obras" class="mt-6 block text-center font-semibold text-primary hover:text-primary-dark sm:hidden">
          Ver todas las obras
        </a>
      </div>
    </section>
  )
}

<script>
  // One instance per .astro render; querySelectorAll handles the (rare)
  // case of multiple featured rows on a page.
  document.querySelectorAll<HTMLElement>("[data-featured-wrap]").forEach((wrap) => {
    const row = wrap.querySelector<HTMLElement>("[data-featured-row]");
    const prevBtn = wrap.querySelector<HTMLButtonElement>("[data-featured-prev]");
    const nextBtn = wrap.querySelector<HTMLButtonElement>("[data-featured-next]");
    const fadeLeft = wrap.querySelector<HTMLElement>("[data-featured-fade-left]");
    const fadeRight = wrap.querySelector<HTMLElement>("[data-featured-fade-right]");
    if (!row || !prevBtn || !nextBtn) return;

    // An arrow function expression (not a hoisted function declaration) so
    // TS's const-narrowing of row/prevBtn/nextBtn above actually carries
    // into this closure.
    const update = () => {
      const scrollable = row.scrollWidth > row.clientWidth + 4;
      prevBtn.hidden = !scrollable;
      nextBtn.hidden = !scrollable;
      if (!scrollable) {
        if (fadeLeft) fadeLeft.hidden = true;
        if (fadeRight) fadeRight.hidden = true;
        return;
      }
      const atStart = row.scrollLeft <= 4;
      const atEnd = row.scrollLeft + row.clientWidth >= row.scrollWidth - 4;
      if (fadeLeft) fadeLeft.hidden = atStart;
      if (fadeRight) fadeRight.hidden = atEnd;
      prevBtn.disabled = atStart;
      nextBtn.disabled = atEnd;
    };

    row.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    prevBtn.addEventListener("click", () => row.scrollBy({ left: -340, behavior: "smooth" }));
    nextBtn.addEventListener("click", () => row.scrollBy({ left: 340, behavior: "smooth" }));
    update();
  });
</script>
