---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

// Shared by the /obras grid and the "related obras" block on the detail
// page, so both places render the exact same card. The data-* attributes
// are read by the vanilla filter script on /obras; they are harmless (and
// unused) wherever that script isn't present.
interface Props {
  obra: CollectionEntry<"obras">;
  /** First-row cards: load eagerly instead of lazily. */
  eager?: boolean;
  /** The single very-first card: hint the browser to fetch it first. */
  priority?: boolean;
}

const { obra, eager = false, priority = false } = Astro.props;
const { titulo, anio, cliente, superficie, ubicacion, categorias, portada } = obra.data;
const href = `/obras/${obra.id}/`;
const searchValue = `${titulo} ${cliente} ${ubicacion ?? ""}`.toLowerCase();
---

<a
  href={href}
  class="obra-card group block"
  data-obra-card
  data-categorias={categorias.join(",")}
  data-cliente={cliente}
  data-anio={anio}
  data-superficie={superficie ?? ""}
  data-search={searchValue}
>
  <div class="aspect-[4/3] overflow-hidden rounded-[var(--radius)] bg-slate-100">
    <Image
      src={portada}
      alt={titulo}
      width={960}
      height={720}
      widths={[320, 480, 640, 960]}
      sizes="(min-width: 1280px) 296px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={priority ? "high" : undefined}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
    />
  </div>
  <div class="mt-3">
    <h3 class="font-semibold leading-snug text-dark">{titulo}</h3>
    <p class="mt-1 text-sm text-muted">{ubicacion || cliente}</p>
    <p class="text-sm text-muted">
      {anio}
      {superficie && ` · ${superficie} m²`}
    </p>
  </div>
</a>
